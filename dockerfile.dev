# syntax=docker/dockerfile:1
# Entorno de desarrollo de lib-mapa (Node 22). Misma version en CI (.github/workflows/ci.yml).
# Para las capturas del mapa (issue lib-mapa#5) se suman mesa/xvfb en ese issue.
FROM node:22-bookworm-slim

ENV CI=true \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .

CMD ["npm", "test"]
