# syntax=docker/dockerfile:1
# Entorno de desarrollo de lib-mapa (Node 22). El CI construye esta misma imagen (.github/workflows/ci.yml y
# release.yml): las versiones de Node, Mesa y MapLibre Native son las mismas en los dos lados.
#
# Base Ubuntu 24.04 (lib-mapa#5): el binario precompilado de @maplibre/maplibre-gl-native 6.x se compila sobre
# Ubuntu 24.04 y pide glibc 2.38, libstdc++ de GCC 13, ICU 74 y libjpeg-turbo 8, que Debian bookworm no trae.
# Node 22 se copia de la imagen oficial (el mismo binario que en node:22-bookworm-slim).
FROM node:22-bookworm-slim AS node

FROM ubuntu:24.04

# Lo que necesita MapLibre Native para dibujar sin pantalla: Xvfb (pantalla virtual), Mesa (OpenGL por software,
# llvmpipe) y las bibliotecas con las que se enlaza mbgl.node. Las capturas corren con `xvfb-run -a`.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      xvfb xauth \
      libgl1 libglx0 libglx-mesa0 libopengl0 libgl1-mesa-dri \
      libcurl4t64 libuv1t64 libjpeg-turbo8 libpng16-16t64 libwebp7 libicu74 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && node --version && npm --version

ENV CI=true \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    LIBGL_ALWAYS_SOFTWARE=1

WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .

CMD ["npm", "test"]
